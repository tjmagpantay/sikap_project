# PHP
vendor/
composer.lock

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
env/
venv/

# Environment/config - SENSITIVE FILES ONLY
.env
config/sikap_db.php
config/google_oauth.php
config/mailer.php
config/db_structure_viewer.php

# Allow template files (safe to commit)
!config/*.template.php

# OS
.DS_Store
Thumbs.db

# ML model
/ml_service/model.pkl


# PRIVATE uploads (sensitive documents - NEVER commit these)
uploads/*
!uploads/.gitkeep
!uploads/*/.gitkeep

# PUBLIC uploads (images are OK, but user uploaded images should not be in Git)
public/uploads/events/*.jfif
public/uploads/events/*.jpg
public/uploads/events/*.jpeg
public/uploads/events/*.png
public/uploads/events/*.gif
public/uploads/banners/*
public/uploads/profile_photos/*
public/uploads/profile_pictures/*
# Keep the directory structure
!public/uploads/.gitkeep
!public/uploads/*/.gitkeep
