{
    "name": "yourname/sikap",
    "description": "A modular PHP web application with ML microservice integration.",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "google/apiclient": "2.15.0",
        "phpmailer/phpmailer": "^6.10",
        "smalot/pdfparser": "^2.12",
        "monolog/monolog": "^3.0",
        "firebase/php-jwt": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (!file_exists('config/sikap_db.php') && file_exists('config/sikap_db.template.php')) { copy('config/sikap_db.template.php', 'config/sikap_db.php'); }\""
        ]
    }
}