# .htaccess for Sikap

RewriteEngine On

# Allow direct access to uploads folder and files

RewriteRule ^uploads/(.\*)$ ../uploads/$1 [L]

# Allow direct access to common file types (don't route through index.php)

RewriteCond %{REQUEST_URI} \.(pdf|doc|docx|jpg|jpeg|png|gif|css|js|ico)$ [NC]
RewriteRule . - [L]

# Redirect all other requests to index.php (only if file/directory doesn't exist)

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Security: Prevent access to config.php

<Files config.php>
    Order allow,deny
    Deny from all
</Files>

# Custom Error Pages
ErrorDocument 404 /sikap/public/index.php?page=404
ErrorDocument 500 /sikap/public/index.php?page=500

# Prevent direct access to sensitive files
<Files "*.php">
    Order Deny,Allow
    Allow from all
</Files>

# Block access to config files
<Files "config.php">
    Order Deny,Allow
    Deny from all
</Files>
